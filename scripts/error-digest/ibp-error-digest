FAILED_UNITS_FILE = re.compile(r"failed-units-(?P<day>\d{4}-\d{2}-\d{2})\.jsonl")
SAFE_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._@:+-]{0,63}")
SAFE_VERSION = re.compile(r"v?\d[0-9A-Za-z.+_-]{0,39}")
STARTING = re.compile(r"(?:[\w.-]+ ){0,3}starting")
FINGERPRINT = re.compile(r"[0-9a-f]{12}")
WEEK_FILE = re.compile(r"(?P<year>\d{4})-W(?P<week>\d{2})\.(?:md|json)")

# Redaction.
CODE = re.compile(r"\b(?P<prefix>TEX|FED)-(?P<id>\d{1,12})-(?P<index>\d{1,9})\b", re.I)
EMAIL = re.compile(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+")
QUOTED = re.compile(
    r"\"[^\"]*(?:\"|$)|(?<!\w)'[^']*(?:'|$)|“[^”]*(?:”|$)|‘[^’]*(?:’|$)|`[^`]*(?:`|$)"
)
KEYWORD = re.compile(r"\w*(?:address|name|inmate)\w*", re.I)
DIGITS = re.compile(r"\d{4,}")
# Secrets: a URL's user and password, an Authorization scheme's credentials,
# the value of a key=, token=, password: ... pair, and any long run of
# base64 or hex with both letters and digits in it (API keys, JWT parts).
USERINFO = re.compile(r"(?<=://)[^\s/@]+@")
AUTH_SCHEME = re.compile(r"\b(?P<scheme>Bearer|Basic|Token)\s+[\w.~+/=-]{8,}", re.I)
SECRET_PAIR = re.compile(
    r"(?P<key>\b[\w-]*(?:key|token|secret|password|passwd|pwd|signature|sig"
    r"|auth|authorization|session|cookie|credentials?)s?)"
    r"(?P<sep>\s*[=:]\s*)(?!(?:Bearer|Basic|Token)\s)(?P<value>[^\s&\"',;<>]+)",
    re.I,
)
JWT = re.compile(r"\beyJ[\w-]+\.[\w-]+(?:\.[\w-]+)?", re.A)
TOKEN = re.compile(
    r"(?<![\w+/=-])(?=[\w+/=-]*\d)(?=[\w+/=-]*[A-Za-z])[\w+/=-]{24,}(?![\w+/=-])",
    re.A,
)

# Stacks.
PY_FRAME = re.compile(
    r'^\s*File "(?P<file>[^"]+)", line (?P<line>\d+), in (?P<func>.+?)\s*$'
)
PY_FILE = re.compile(r'^[ \t]*File "', re.M)
PY_CHAIN = re.compile(
    r"^(?:During handling of the above exception|"
    r"The above exception was the direct cause)"
)
EXC_LINE = re.compile(r"(?P<type>[A-Za-z_$][\w$.]*)(?::\s?(?P<message>.*))?")
JS_CHROME = re.compile(
    r"^\s*at (?:(?P<func>.+?) \()?(?P<url>[^\s()]+?):(?P<line>\d+):\d+\)?\s*$"
)
JS_FIREFOX = re.compile(r"^\s*(?P<func>[^@\s]*)@(?P<url>\S+?):(?P<line>\d+):\d+\s*$")
JS_BUNDLE_HASH = re.compile(r"-[A-Za-z0-9_-]{8}(?=\.m?js$)")


# --------------------------------------------------------------------------
# Redaction and fingerprints


def redact(text: Any, limit: int = MAX_TEXT) -> str:
    """``text`` with secrets and e-mail addresses replaced; one line.

    Inmate names, TDCJ numbers, unit addresses and codes are kept: they are
    largely public and they help find the cause (decided 2026-11-28).
    """
    if not isinstance(text, str):
        return ""
    if len(text) > MAX_SCAN:
        # Cut at a space, so no code or number is cut in half.
        text = text[:MAX_SCAN]
        space = max(text.rfind(c) for c in " \t\n")
        text = text[:space] if space > 0 else text
    # A lone surrogate (an escaped one passes json.loads) can't be written.
    text = text.encode("utf-8", "replace").decode("utf-8")
    out = USERINFO.sub("<secret>@", text)
    out = AUTH_SCHEME.sub(lambda m: f"{m['scheme']} <secret>", out)
    out = SECRET_PAIR.sub(lambda m: f"{m['key']}{m['sep']}<secret>", out)
    out = JWT.sub("<secret>", out)
    out = TOKEN.sub("<secret>", out)
    out = EMAIL.sub("<email>", out)
    out = " ".join(out.split())
    if len(out) > limit:
        out = out[: limit - 3].rstrip() + "..."
    return out


def normalize(redacted: str) -> str:
    """A redacted message with what varies between occurrences removed.

    Only for fingerprints: codes, quoted text, whatever follows "address",
    "name" or "inmate", and numbers, so one error with different inmates
    or packages stays one group.
    """
    out = CODE.sub(lambda m: f"{m['prefix'].upper()}-#-#", redacted)
    out = QUOTED.sub("<text>", out)
    keyword = KEYWORD.search(out)
    if keyword:
        out = out[: keyword.end()] + (" <x>" if out[keyword.end() :].strip() else "")
    out = re.sub(r"\b[0-9a-fA-F]{8,}\b", "<hex>", out)
    out = re.sub(r"\d+", "<n>", out)
    out = re.sub(r"#+", "#", out)
    return " ".join(out.split())


def clean_name(value: Any) -> str | None:
    if isinstance(value, str) and SAFE_NAME.fullmatch(value.strip()):
        return value.strip()
    return None


def clean_version(value: Any) -> str | None:
    if isinstance(value, str) and SAFE_VERSION.fullmatch(value.strip()):
        return value.strip()
    return None


@dataclass
class Frame:
    file: str
    line: int
    func: str
    ibp: bool

    def text(self) -> str:
        where = f"{self.file}:{self.line}"
        return f"{where} {self.func}" if self.func else where


@dataclass
class Stack:
    type: str = ""
    message: str = ""  # redacted
    frames: list[Frame] = field(default_factory=list)  # innermost last

    def innermost(self) -> Frame | None:
        for frame in reversed(self.frames):
            if frame.ibp:
                return frame
        return self.frames[-1] if self.frames else None


def python_file(path: str) -> tuple[str, bool]:
    """A traceback path made short and free of user folders, and whether it
    is IBP code."""
    parts = [p for p in re.split(r"[\\/]+", path) if p]
    if not parts:
        return "?", False
    start = 0
    for i, part in enumerate(parts[:-1]):
        if part in SITE_DIRS:
            start = i + 1
    package = None
    for i in range(start, len(parts) - 1):
        if parts[i] in IBP_PACKAGES:
            package = i
    if package is not None:
        return "/".join(parts[package:]), True
    if parts[-1].startswith("ibp-"):
        return parts[-1], True
    if start:
        return "/".join(parts[start:]), False
    return "/".join(parts[-2:]), False


def js_file(url: str) -> tuple[str, bool, bool]:
    """A stack frame's URL as a short path, whether it is IBP code, and
    whether it is a bundle (its hash dropped; its function names minified)."""
    scheme, _, rest = url.partition("://")
    if not rest:
        return url[-80:], False, False
    path = rest.partition("/")[2].split("?")[0].split("#")[0]
    unhashed = JS_BUNDLE_HASH.sub("", path)
    bundled = unhashed != path
    path = unhashed or scheme
    ibp = scheme in {"http", "https", "moz-extension"} and "node_modules" not in path
    return path[-80:], ibp, bundled


def safe_func(name: str) -> str:
    name = name.strip() or "?"
    return re.sub(r"[^\w.<>$ -]", "?", name)[:80]


def parse_python(lines: list[str]) -> Stack:
    start = 0
    for i, line in enumerate(lines):
        if PY_CHAIN.match(line):
            start = i + 1
    stack = Stack()
    last_frame = None
    for i in range(start, len(lines)):
        match = PY_FRAME.match(lines[i])
        if match:
            file, ibp = python_file(match["file"])
            stack.frames.append(
                Frame(file, int(match["line"]), safe_func(match["func"]), ibp)
            )
            last_frame = i
    after = start if last_frame is None else last_frame + 1
    for line in lines[after:]:
        if not line.strip() or line[:1].isspace() or line.startswith("Traceback"):
            continue
        match = EXC_LINE.fullmatch(line.strip())
        if match:
            stack.type = match["type"][:80]
            stack.message = redact(match["message"] or "")
        break
    return stack


def parse_js(lines: list[str]) -> Stack:
    stack = Stack()
    frames = []
    for line in lines:
        match = JS_CHROME.match(line) or JS_FIREFOX.match(line)
        if match:
            file, ibp, bundled = js_file(match["url"])
            # A bundle's function names change with every build: left out.
            func = "" if bundled else safe_func(match["func"] or "")
            frames.append(Frame(file, int(match["line"]), func, ibp))
        elif not frames and not stack.type and line.strip():
            first = EXC_LINE.fullmatch(line.strip())
            if first and re.search(r"(Error|Exception)$", first["type"]):
                stack.type = first["type"][:80]
                stack.message = redact(first["message"] or "")
    stack.frames = list(reversed(frames))  # JS lists the innermost first
    return stack


def parse_stack(exc: Any) -> Stack | None:
    if not isinstance(exc, str) or not exc.strip():
        return None
    lines = [line[:MAX_STACK_LINE] for line in exc.splitlines()]
    if "Traceback (most recent call last)" in exc or PY_FILE.search(exc):
        # Python's innermost frames and exception come last, JavaScript's first.
        return parse_python(lines[-MAX_STACK_LINES:])
    return parse_js(lines[:MAX_STACK_LINES])


def fingerprint(
    app: str,
    stack: Stack | None,
    message: str,
    logger: str | None = None,
    status: int | None = None,
) -> str:
    """The group key: for a browser app, where it was reported (``logger``),
    the HTTP status, the exception type and the message's shape, since its
    frames are minified or shared by every API call; for any other app with
    an exception, the type and the innermost IBP frame; else the message's
    shape."""
    frame = stack.innermost() if stack else None
    if app in BROWSER_APPS:
        kind = stack.type if stack else ""
        key = f"{app}|browser|{logger or ''}|{status or ''}|{kind}|{normalize(message)}"
    elif stack and (stack.type or frame):
        where = f"{frame.file}:{frame.func}" if frame else ""
        key = f"{app}|exc|{stack.type}|{where}"
    else:
        key = f"{app}|msg|{normalize(message)}"
    return hashlib.sha256(key.encode("utf-8", "replace")).hexdigest()[:12]


